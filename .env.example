# Protects POST/GET /api/indexnow (Bearer or ?secret=). Never commit the real value.
# Generate: openssl rand -hex 24
INDEXNOW_SUBMIT_SECRET=

# Le workflow .github/workflows/indexnow.yml n’utilise pas ce secret :
# il appelle api.indexnow.org directement (clé publique).

# Google Analytics 4. Valeur publique, lue au build (NEXT_PUBLIC_).
# Laisser vide : aucun script Google n'est chargé.
# Avec un identifiant G-XXXXXXXX, gtag.js ne part qu'après « Accepter ».
# Sur Vercel : Project → Settings → Environment Variables, puis redéployer.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
